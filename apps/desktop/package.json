{
  "name": "@orchdeck/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main/index.js",
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@orchdeck/daemon": "workspace:*",
    "@orchdeck/shared": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.6.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "electron .",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "build": "pnpm run build:main && pnpm run build:preload && pnpm run build:renderer",
    "typecheck": "tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  }
}
