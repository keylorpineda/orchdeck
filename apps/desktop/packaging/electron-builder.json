{
  "appId": "com.orchdeck.desktop",
  "productName": "Orchdeck",
  "copyright": "Copyright (c) 2026 Orchdeck Contributors",
  "directories": {
    "output": "release",
    "buildResources": "packaging"
  },
  "files": [
    "dist/main/**/*",
    "dist/preload/**/*",
    "dist/renderer/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64", "arm64"]
      }
    ],
    "verifyUpdateCodeSignature": true
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false
  },
  "mac": {
    "category": "public.app-category.developer-tools",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "packaging/entitlements.mac.plist",
    "entitlementsInherit": "packaging/entitlements.mac.plist",
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64", "x64"]
      },
      {
        "target": "zip",
        "arch": ["arm64", "x64"]
      }
    ]
  },
  "publish": [
    {
      "provider": "github",
      "owner": "keylorpineda",
      "repo": "orchdeck",
      "releaseType": "release"
    }
  ]
}
