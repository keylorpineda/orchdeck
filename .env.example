# Orchdeck Local Development Configuration (Non-Secret Settings Only)
#
# SECURITY WARNING:
# Orchdeck authenticates Claude Code, Codex CLI, and Antigravity CLI strictly
# through your local CLI subscriptions. NEVER place provider billing API keys
# (ANTHROPIC_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY, GOOGLE_API_KEY) in .env
# or commit any .env file to Git.

# Core Daemon log verbosity: error | warn | info | debug
ORCHDECK_LOG_LEVEL=info

# Optional override for Orchdeck local SQLite and runtime directory
# Defaults to the OS user application data directory when unset.
ORCHDECK_DATA_DIR=

# Optional override for the Core Daemon Named Pipe (Windows) or Unix Domain Socket (macOS/Linux)
ORCHDECK_DAEMON_SOCKET=
